{
  "type": "object",
  "title": "Config",
  "properties": {
    "themeID": {
      "type": "string",
      "enum": [
        "default",
        "dark",
        "light",
        "hundredK"
      ],
      "default": "default",
      "title": "Theme",
      "description": "The default theme switches between dark and light based on user browser preferences"
    },
    "highlight": {
      "type": "string",
      "enum": [
        "yellow",
        "pink",
        "cyan",
        "darkBlue",
        "red"
      ],
      "default": "yellow",
      "title": "Highlight",
      "description": "Pick a highlight color from the list or get in touch for custom requests."
    },
    "fontName": {
      "type": "string",
      "enum": [
        "default",
        "custom",
        "Schibsted_Grotesk",
        "Hanken_Grotesk",
        "Young_Serif",
        "Gothic_A1",
        "jost",
        "IBM_Plex_Mono",
        "EB_Garamond",
        "Karla",
        "Courier",
        "Kosugi_Maru",
        "Inter",
        "Atkinson_Hyperlegible_Next",
        "Oswald",
        "Work_Sans",
        "Open_Sans"
      ],
      "default": "jost",
      "title": "Font"
    },
    "showSearch": {
      "type": "boolean",
      "default": false,
      "description": "Allows users to search your website",
      "title": "Enable Search"
    },
    "showLogin": {
      "type": "boolean",
      "default": false,
      "description": "Allows users to login to your website",
      "title": "Enable Login"
    },
    "showHeroImage": {
      "type": "boolean",
      "default": false,
      "description": "Shows your hero image on the home page",
      "title": "Show Hero Image"
    },
    "noHeroOverlay": {
      "type": "boolean",
      "default": false,
      "description": "Removes the opacity overlay",
      "title": "Remove Hero Opacity Overlay"
    }
  }
}
